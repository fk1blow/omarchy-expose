#!/bin/bash
set -euo pipefail

address="${1:-}"
app_id="${2:-}"
title="${3:-}"
move_cursor="${4:-false}"

if [[ ! $address =~ ^0x[0-9a-fA-F]+$ ]]; then
  address=$(hyprctl -j clients | jq -r --arg app "${app_id,,}" --arg title "$title" '
    [.[] | select(.mapped != false)
      | select(((.class // "") | ascii_downcase) == $app or ((.initialClass // "") | ascii_downcase) == $app)
      | select((.title // "") == $title)][0].address // empty')
fi

[[ $address =~ ^0x[0-9a-fA-F]+$ ]] || exit 2

# Let the layer-shell surface unmap before taking final compositor focus.
# Poll for the actual unmap rather than sleeping a flat 0.2s: the surface is
# normally gone within a frame or two, and a check costs ~2ms, so activation
# stops paying 200ms every time for a wait that is almost never needed. The
# iteration cap must outlast the overlay's fade-out (~226ms), or the poll
# expires mid-animation and focuses before the unmap - the case it guards.
for _ in $(seq 1 60); do
  hyprctl layers 2>/dev/null | grep -q "expose-window-overview" || break
  sleep 0.005
done

if [[ $move_cursor != "true" ]]; then
  cursor_position=$(hyprctl cursorpos 2>/dev/null || true)
  IFS=',' read -r cursor_x cursor_y <<< "$cursor_position"
  cursor_x="${cursor_x//[[:space:]]/}"
  cursor_y="${cursor_y//[[:space:]]/}"

  if [[ ! $cursor_x =~ ^-?[0-9]+([.][0-9]+)?$ || ! $cursor_y =~ ^-?[0-9]+([.][0-9]+)?$ ]]; then
    echo "expose: could not preserve the pointer position; activating the window anyway" >&2
    cursor_x=""
    cursor_y=""
  fi
fi

hyprctl eval "hl.dispatch(hl.dsp.focus({ window = 'address:$address' }))" >/dev/null

# Focus alone does not restack. Tiled windows never overlap so it goes unnoticed,
# but a floating window activated from the overview takes input while still
# sitting behind whatever it overlaps.
hyprctl eval "hl.dispatch(hl.dsp.window.bring_to_top({ window = 'address:$address' }))" >/dev/null

if [[ -n ${cursor_x:-} && -n ${cursor_y:-} ]]; then
  hyprctl eval "hl.dispatch(hl.dsp.cursor.move({ x = $cursor_x, y = $cursor_y }))" >/dev/null
fi
